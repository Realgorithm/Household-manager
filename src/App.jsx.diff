+function ToastStack({ toasts, onDismiss }) {
+  if (toasts.length === 0) return null;
+  return (
+    <div
+      className="flex flex-col gap-2"
+      style={{ position: "fixed", top: 16, right: 16, left: 16, zIndex: 1000, maxWidth: 360, marginLeft: "auto" }}
